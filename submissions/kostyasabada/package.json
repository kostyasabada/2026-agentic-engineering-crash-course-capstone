{
  "name": "kostyasabada-chat-capstone",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "npm": ">=9"
  },
  "scripts": {
    "openspec": "openspec",
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "next build && playwright test",
    "test:e2e:dev": "E2E_SERVER_MODE=dev playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e",
    "check:loop": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e:dev"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  }
}
